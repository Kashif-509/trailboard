{
  "name": "trailboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TrailBoard: a deliberately slow hiking-trail dashboard used to practise web performance fixes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@size-limit/file": "^14.3.0",
    "@types/lodash-es": "^4.17.12",
    "rollup-plugin-visualizer": "^7.1.3",
    "size-limit": "^14.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
