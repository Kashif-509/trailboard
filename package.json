{
  "name": "trailboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TrailBoard: a deliberately slow hiking-trail dashboard used to practise web performance fixes.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
