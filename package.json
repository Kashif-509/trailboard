    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "@types/lodash": "^4.17.0"
  }
}
